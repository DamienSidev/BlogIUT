{% extends 'base.html.twig' %}

{% block body %}
    <div class="card">
        <div class="card-title">Modification de l'article n°{{ article.id }}</div>
        {{ form_start(form) }}
        <div class="card-body">
            <div class="row">
                {{ form_row(form.title) }}
            </div>
            <div class="row mt-2">
                {{ form_row(form.content) }}
            </div>
        </div>
        <div class="card-footer d-flex justify-content-end">
            {{ form_row(form.submit) }}
        </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
