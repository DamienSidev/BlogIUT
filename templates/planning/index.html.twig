{% extends 'base.html.twig' %}

{% block body %}
    {% for color, message in app.flashes %}
        <div class="row">
            <div class="alert alert-{{ color }}">
                {{ message[0] }}
            </div>
        </div>
    {% endfor %}
    <div id="calendar"></div>
{% endblock %}

{% block importmap %}
    {{ encore_entry_script_tags('planning') }}
{% endblock %}
